# ==========================================
# BrandPrint AI — Root .gitignore
# ==========================================

# Environment & Secrets (CRITICAL: Never commit secrets)
.env
.env.*
!.env.example
*.env
backend/.env
frontend/.env
backend/.env.*
frontend/.env.*
!backend/.env.example
!frontend/.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# Node & Frontend
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
frontend/dist/
frontend/dist-ssr/
*.local

# Database & Storage
*.sqlite3
*.db
*.db-journal
test_db*

# FAISS and Local Vectors Cache
faiss_index/
*.faiss
*.pkl

# Logs & Temporary Files
*.log
logs/
temp/
tmp/
*.tmp

# Operating System & IDEs
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
